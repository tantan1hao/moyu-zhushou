#!/bin/zsh
set -euo pipefail

console_user="$(/usr/bin/stat -f %Su /dev/console 2>/dev/null || true)"
if [[ -z "${console_user}" || "${console_user}" == "root" ]]; then
  exit 0
fi

user_app="/Users/${console_user}/Library/Input Methods/MoyuAssistant.app"
if [[ ! -d "${user_app}" ]]; then
  exit 0
fi

bundle_id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "${user_app}/Contents/Info.plist" 2>/dev/null || true)"
if [[ "${bundle_id}" == "com.tantan1hao.inputmethod.moyuassistant" ]]; then
  /bin/rm -rf "${user_app}"
fi
